#!/bin/sh
# Stop any commit that adds a key, token, or other secret, so nothing private
# ever reaches the history. CI runs the same scan over the whole history.
# Turn it on once per clone: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks); commit stopped" >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner .
