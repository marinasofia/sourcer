# Lambda container image. The handler persists SQLite state to S3.
# Local smoke test with the bundled runtime emulator:
#   docker build -f Dockerfile.lambda -t sourcer-lambda .
#   docker run --rm -p 127.0.0.1:9000:8080 -e ANTHROPIC_API_KEY=... -e SOURCER_SKIP_S3=1 sourcer-lambda
FROM public.ecr.aws/lambda/python:3.14@sha256:252cbb0879717b1c049b9f909d86d06d88e129f3208386d7ba1189d535f5f981

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

COPY requirements.txt ./
RUN pip install --require-hashes -r requirements.txt

COPY pyproject.toml README.md LICENSE ./
COPY sourcer/ ${LAMBDA_TASK_ROOT}/sourcer/
RUN pip install --no-deps .

# carries the operator's skills vector: push only to a private registry
COPY companies.json skills_vector.json ${LAMBDA_TASK_ROOT}/
ENV SOURCER_ROOT=/var/task \
    SOURCER_DB=/tmp/sourcer.db \
    SOURCER_COMPANIES=/var/task/companies.json \
    SOURCER_SKILLS=/var/task/skills_vector.json

CMD ["sourcer.lambda_handler.handler"]
