# Copy to .env. Never commit .env. Every variable is optional except the key.
ANTHROPIC_API_KEY=sk-ant-...

# Spend and model
SOURCER_COST_CAP=2.50
SOURCER_MODEL=claude-haiku-4-5-20251001
SOURCER_LOG_LEVEL=INFO

# Inputs (defaults are relative to the repository root)
# SOURCER_SKILLS=skills_vector.json
# SOURCER_COMPANIES=companies.json
# SOURCER_PROFILE=profile.json
# SOURCER_DB=data/sourcer.db
# SOURCER_ROOT=/path/to/checkout   # only for an installed package or a container

# Storage backend: sqlite (default) or snowflake
# SOURCER_BACKEND=sqlite
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=

# Sources and alerts
# SOURCER_SIMPLIFY=1
# SOURCER_DEGREE=Bachelor's
# SOURCER_ALERT_SCORE=85
# SOURCER_ALERT_CAP=60
# SOURCER_FRESHNESS_DAYS=21

# Telegram is fail-closed. Keep dry run enabled until both allowlists are set.
# SOURCER_DRY_RUN=1
# SOURCER_TELEGRAM_TOKEN=
# SOURCER_TELEGRAM_ALLOWED_CHAT_IDS=
# SOURCER_TELEGRAM_ALLOWED_USER_IDS=
# SOURCER_TELEGRAM_SCORE_THRESHOLD=75

# Weekly VC portfolio discovery. Getro credentials are optional.
# SOURCER_GETRO_API_KEY=
# SOURCER_GETRO_NETWORKS={"a16z":"network-id","usv":"network-id"}

# Lambda state (only for the Lambda container)
# SOURCER_S3_BUCKET=
# SOURCER_SKIP_S3=1
